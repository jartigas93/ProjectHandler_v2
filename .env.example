# ============================================================================
# CLAVES DE PROVEEDORES DE INTELIGENCIA ARTIFICIAL
# ============================================================================
# Google Gemini (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=""

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=""

# Microsoft Copilot / Azure OpenAI
AZURE_OPENAI_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR WEB
# ============================================================================
PORT=3000
APP_URL="http://localhost:3000"

# ============================================================================
# MODELOS DE FÁBRICA / DEFAULT POR PROVEEDOR (Configurables)
# Lista de identificadores técnicos separados por coma para cada proveedor
# ============================================================================
FACTORY_MODELS_GEMINI="gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash"
FACTORY_MODELS_CLAUDE="claude-3-7-sonnet-20250219,claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022"
FACTORY_MODELS_OPENAI="gpt-4o,gpt-4o-mini,o3-mini"
FACTORY_MODELS_COPILOT="copilot-gpt-4o,copilot-gpt-4o-mini"

# ============================================================================
# PERSISTENCIA CENTRALIZADA EN BASE DE DATOS (Opcional)
# Dejar vacío si se utiliza almacenamiento local (localStorage / SQLite local)
# ============================================================================
# DATABASE_URL="postgresql://usuario:password@localhost:5432/projecthandler"
# DATABASE_TYPE="none" # opciones: none, postgres, mysql, sqlite, snowflake, mongodb
# SNOWFLAKE_ACCOUNT=""
